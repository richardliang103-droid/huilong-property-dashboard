# Destination JSON file (committed to repo)
HUILONG_DEST=/Users/richard/huilong-property-dashboard/data/properties.json

# Optional: Python interpreter to use (defaults to the web-clipper venv)
# PYTHON=/Users/richard/.hermes/venvs/web-clipper/bin/python3