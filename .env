# Environment variables for huilong-property-dashboard
# Adjust these paths if your setup differs

# Path to the Excel file
HUILONG_EXCEL=/Users/richard/Library/CloudStorage/SynologyDrive-Hermes/Houses/迴龍物件追蹤.xlsx

# Path to the source health JSON (generated by the Argus watcher)
